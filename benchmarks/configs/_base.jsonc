{
  // Shared base for every benchmark condition of the AndroidWorld paper rework.
  // Not a runnable condition by itself (files starting with "_" are bases).
  //
  // = the January 2026 full system (branch ablation/a9-final, every paper-era flag on) with the
  //   "Platform Default" routing (llm-config.defaults.jsonc "recommended" preset), served by
  //   OpenRouter directly instead of the shut-down `minitap` provider.
  "name": "_base",
  "description": "Base: paper-era full system, Platform Default routing via OpenRouter.",

  // Model substitutions vs. the paper (decided by Pilou on 2026-11-09, see benchmarks/README.md):
  // Cortex google/gemini-3-pro-preview -> google/gemini-3.1-pro-preview (paper id removed from
  // OpenRouter), Executor meta-llama/llama-3.1-70b-instruct -> meta-llama/llama-3.3-70b-instruct
  // (no tool-calling endpoint left for 3.1 70B).

  "ablation": {
    "use_multi_agent": true,
    "use_sequential_execution": true,
    "use_post_validation": true,
    "use_deterministic_text": true,
    "use_vision": true,
    "use_meta_reasoning": true,
    "use_scratchpad": true,
    "use_video_recording": true,
    "use_data_fidelity_prompts": true,
    // Added on paper/androidworld-rework (not in the January 2026 system): off in the base.
    "use_loop_detector": false,
    "use_text_match_check": false,
    // Fix round (2026-11-10): verify every goal requirement before ending (multi-agent only).
    "use_goal_verification": true,
    // Off everywhere except v1-as-shipped.jsonc: restores the v1 Android bugs A10/A11.
    "legacy_v1_android_bugs": false
  },

  "loop_detector": {
    "window": 12,              // transitions looked at for "repeat"
    "repeat_threshold": 3,     // same (state, action) >= 3 times in the window -> trigger
    "no_change_threshold": 3,  // 3 consecutive UI actions with no screen change -> trigger
    "cycle_window": 8,         // last 8 transitions ...
    "cycle_max_distinct": 2,   // ... visiting <= 2 distinct screens -> trigger
    "cooldown": 3,             // transitions before the detector may fire again
    "escalate_after": 2,       // 2 triggers without reaching a new screen -> forced replan
    "include_bounds": false
  },

  "text_check": {
    "mismatch_as_error": false // verdict is reported to the Cortex; the tool call stays "success"
  },

  "llm_policy": {
    "allow_fallback": false,   // a fallback would silently change the model under test
    "max_retries": 4,          // HTTP-level retries inside the OpenAI client (same model)
    "timeout_s": 180,
    // Agent-level retries of the SAME model on any failure (malformed 200 responses, parse
    // errors...), with linear backoff; each one is an `llm_retry` event.
    "same_model_retries": 2,
    "retry_backoff_s": 2,
    // OpenRouter provider routing, sent as the request `provider` object.
    // require_parameters: only route to endpoints that support every parameter we send
    // (tools / response_format), instead of silently dropping them.
    "openrouter_provider": {
      "require_parameters": true
    },
    // One pinned OpenRouter endpoint per model, no provider fallback (decided 2026-11-09).
    // Choice: unquantized or fp8 weights, endpoint supporting what the role sends (tools for the
    // Executor / a0 Cortex, json_schema for the others), 100 % (or best) 1-day uptime on the
    // OpenRouter endpoints API on 2026-11-09. Values are OpenRouter endpoint tags.
    // Every model used by any config must have a pin (tests/mobile_use/benchmark/test_config.py).
    "openrouter_provider_by_model": {
      // Google Vertex standard tier (99.93 % 1d); AI Studio 98.9 %, the flex tier was down.
      "google/gemini-3.1-pro-preview": { "order": ["google-vertex/global"], "allow_fallbacks": false },
      // Same provider as the Cortex for the video analyzer (100 % 1d).
      "google/gemini-3-flash-preview": { "order": ["google-vertex/global"], "allow_fallbacks": false },
      // DeepInfra fp8 standard endpoint (json_schema, 100 % 1d); the only other endpoint (Vertex)
      // publishes neither quantization nor uptime.
      "meta-llama/llama-4-scout": { "order": ["deepinfra/fp8"], "allow_fallbacks": false },
      // bf16 (most endpoints serve the MXFP4 weights); DeepInfra bf16: tools + json_schema, 100 % 1d.
      "openai/gpt-oss-120b": { "order": ["deepinfra/bf16"], "allow_fallbacks": false },
      // No bf16 endpoint exists; CoreWeave serves unquantized fp16 with tool calling, 100 % 1d
      // (fp8 alternatives with tools: AkashML, DeepInfra turbo).
      "meta-llama/llama-3.3-70b-instruct": { "order": ["coreweave/fp16"], "allow_fallbacks": false },
      // Only bf16 endpoint, and the only one with json_schema support, 100 % 1d.
      "meta-llama/llama-3.1-8b-instruct": { "order": ["coreweave/bf16"], "allow_fallbacks": false },
      // First-party OpenAI (billed through the account's BYOK OpenAI key).
      "openai/gpt-5-nano": { "order": ["openai"], "allow_fallbacks": false },
      "openai/gpt-4o": { "order": ["openai"], "allow_fallbacks": false },
      // Single endpoint on OpenRouter (bf16).
      "qwen/qwen3-vl-8b-instruct": { "order": ["parasail/bf16"], "allow_fallbacks": false },
      // Google AI Studio standard tier, the only provider listed (99.93 % / 100 % 1d).
      "google/gemini-2.5-pro": { "order": ["google-ai-studio"], "allow_fallbacks": false },
      "google/gemini-2.5-flash": { "order": ["google-ai-studio"], "allow_fallbacks": false }
    }
  },

  "llm": {
    "cortex": {
      "provider": "openrouter",
      // Paper: google/gemini-3-pro-preview (404 "no longer available" on OpenRouter, 2026-11-09).
      "model": "google/gemini-3.1-pro-preview"
    },
    "planner": { "provider": "openrouter", "model": "meta-llama/llama-4-scout" },
    "orchestrator": { "provider": "openrouter", "model": "openai/gpt-oss-120b" },
    "executor": {
      "provider": "openrouter",
      // Paper: meta-llama/llama-3.1-70b-instruct (its only OpenRouter endpoint, Amazon Bedrock,
      // has no tool calling, 2026-11-09). 3.3 70B is also the Executor of the hardcoded Minitap
      // profile (config.py get_default_minitap_llm_config).
      "model": "meta-llama/llama-3.3-70b-instruct",
      // The Executor binds its tools with parallel_tool_calls=true (executor.py). No OpenRouter
      // endpoint of any model used here declares `parallel_tool_calls` (checked 2026-11-09), so
      // require_parameters=true would 404. OpenRouter still filters on tool support ("Filter by
      // Tool Compatibility") when require_parameters is false; only parallel_tool_calls may be
      // dropped. Kept for every Executor model (deep-merged into the configs that change it).
      "openrouter_provider": { "require_parameters": false }
    },
    "contextor": { "provider": "openrouter", "model": "meta-llama/llama-3.1-8b-instruct" },
    "utils": {
      // gpt-5-nano accepts no `temperature` parameter; mobile-use always sends one (hopper 0,
      // outputter 1). With require_parameters=true OpenRouter finds no endpoint (404), so it is
      // disabled for this model only: OpenRouter then drops `temperature` (OpenAI's gpt-5 models
      // only run at their default temperature anyway).
      "hopper": {
        "provider": "openrouter",
        "model": "openai/gpt-5-nano",
        "openrouter_provider": { "require_parameters": false }
      },
      "outputter": {
        "provider": "openrouter",
        "model": "openai/gpt-5-nano",
        "openrouter_provider": { "require_parameters": false }
      },
      "video_analyzer": { "provider": "openrouter", "model": "google/gemini-3-flash-preview" }
    }
  },

  "agent": {
    "max_steps": 400,   // LangGraph recursion limit (= paper step limit)
    "timeout_s": null,  // optional wall-clock cap per task, seconds
    "record_trace": false
  }
}
