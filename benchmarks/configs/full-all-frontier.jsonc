{
  // P3 #3: "All Frontier" = the frontier model on all seven agents (paper Table 4 row 2).
  // Paper model google/gemini-3-pro-preview is gone; google/gemini-3.1-pro-preview as decided
  // (see _base.jsonc). video_analyzer keeps the Platform Default model (not part of the table).
  "extends": "full.jsonc",
  "name": "full-all-frontier",
  "description": "Full system, frontier model on all seven agents.",
  "llm": {
    "cortex": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
    "planner": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
    "orchestrator": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
    "executor": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
    "contextor": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
    "utils": {
      "hopper": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" },
      "outputter": { "provider": "openrouter", "model": "google/gemini-3.1-pro-preview" }
    }
  }
}
